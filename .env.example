# ╔══════════════════════════════════════════════════╗
# ║   UCSI Agentic AI CTF 2026 — Agent Config       ║
# ╚══════════════════════════════════════════════════╝
#
# Copy this file to .env and fill in your keys.
# Never commit the .env file to version control.

# ── LLM Provider ──
# Options: openai, anthropic, ollama, groq
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o

# ── API Keys ──
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...

# ── Ollama (local) ──
OLLAMA_BASE_URL=http://localhost:11434

# ── Agent Settings ──
MAX_ITERATIONS=25
VERBOSE=true

# ── Challenge Targets ──
# CTF_TARGET_HOST=52.76.96.108
# CTF_TARGET_PORT=9005
