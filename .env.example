# ╔══════════════════════════════════════════════════╗
# ║   UCSI Agentic AI CTF 2026 — Agent Config       ║
# ╚══════════════════════════════════════════════════╝
#
# Copy this file to .env and fill in your keys.
# Never commit the .env file to version control.

# ── LLM Provider ──
# Options: openai, anthropic, ollama, groq
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.6-terra

# ── API Keys ──
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...

# ── Ollama (local) ──
# Example tool-capable local model: qwen3
OLLAMA_BASE_URL=http://localhost:11434

# ── Agent Settings ──
MAX_ITERATIONS=25
VERBOSE=true

# Targets are supplied explicitly to `python run.py solve --host ... --port ...`.
